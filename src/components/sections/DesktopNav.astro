---
import { Icon } from 'astro-icon/components';
import { sections } from '../../data/site';
const items = sections.filter((s) => s.id !== 'connect');
---

<nav id="desktop" class="desktop" aria-label="Sections">
  <ul>
    {
      items.map((s) => (
        <li>
          <a class="dicon" href={`#${s.id}`}>
            <span class="dicon__img">
              <Icon name={s.icon} aria-hidden="true" />
            </span>
            <span class="dicon__label">{s.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .desktop {
    margin: 48px auto 32px;
    max-width: 640px;
  }
  ul {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px 12px;
  }
  .dicon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--paper);
    padding: 6px 4px;
    outline: none;
  }
  .dicon__img {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    background: var(--win-gray);
    color: var(--accent);
    box-shadow: var(--shadow-outer-3);
  }
  .dicon__img :global(svg) {
    width: 30px;
    height: 30px;
    stroke-width: 1.75;
  }
  .dicon__label {
    padding: 1px 4px;
    text-align: center;
    text-shadow: 1px 1px 0 var(--win-dark);
  }
  .dicon:hover .dicon__label,
  .dicon:focus-visible .dicon__label {
    background: var(--accent);
    text-shadow: none;
    outline: 1px dotted var(--paper);
  }
  .dicon:active .dicon__img {
    box-shadow: var(--shadow-inner-3);
  }
  @media (max-width: 420px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
