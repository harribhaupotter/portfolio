---
import { Icon } from 'astro-icon/components';
import Window from '../Window.astro';
import { profile, socials } from '../../data/site';
---

<Window id="connect" title="Let's connect" icon="lucide:mail" class="connect" status={["Ready", `${socials.length} network nodes`]}>
  <div class="connect__grid">
    <fieldset class="net">
      <legend>Network neighborhood</legend>
      <div class="net__me">
        <span class="node node--me bevel-out">
          <Icon name="lucide:user" aria-hidden="true" />
        </span>
        <span class="net__label">Me</span>
      </div>
      <ul class="net__nodes">
        {
          socials.map((s) => (
            <li>
              <a class="node-link" href={s.href} target="_blank" rel="noopener noreferrer">
                <span class="node bevel-out">
                  <Icon name={s.icon} aria-hidden="true" />
                </span>
                <span class="net__label">{s.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="net__wip">
        <span class="node node--wip bevel-out" aria-hidden="true">
          <Icon name="lucide:hard-drive" />
        </span>
        <p>
          <b>Personal portfolio</b>
          <span>Work in progress, coming later.</span>
        </p>
      </div>
    </fieldset>

    <form class="mail" action={`mailto:${profile.email}`} method="get">
      <fieldset>
        <legend>New message</legend>
        <div class="mail__row">
          <label for="mail-to">To:</label>
          <input id="mail-to" type="text" value={profile.email} readonly />
        </div>
        <div class="mail__row">
          <label for="mail-subject">Subject:</label>
          <input id="mail-subject" name="subject" type="text" placeholder="Hi there" />
        </div>
        <label class="sr-only" for="mail-body">Message</label>
        <textarea id="mail-body" name="body" rows="7" placeholder="Write your message…"></textarea>
        <div class="mail__actions">
          <a class="btn" href={`mailto:${profile.email}`}>
            <Icon name="lucide:at-sign" class="icon" aria-hidden="true" />
            Open mail app
          </a>
          <button type="submit" class="is-highlighted">
            <Icon name="lucide:send" class="icon" aria-hidden="true" />
            Send
          </button>
        </div>
      </fieldset>
    </form>
  </div>
</Window>

<style>
  .connect__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 14px;
  }
  fieldset {
    padding: 16px 12px 12px;
    margin: 0;
    min-width: 0;
    height: 100%;
  }
  legend {
    padding: 0 6px;
  }

  /* ---------- network tree ---------- */
  .net {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .net__me {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    position: relative;
    padding-bottom: 18px;
  }
  .net__me::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    height: 14px;
    border-left: 2px solid var(--ink);
  }
  .net__nodes {
    list-style: none;
    padding: 18px 0 0;
    margin: 0;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px 6px;
    position: relative;
  }
  .net__nodes::before {
    content: '';
    position: absolute;
    top: 0;
    left: calc(100% / 6);
    right: calc(100% / 6);
    border-top: 2px solid var(--ink);
  }
  .net__nodes li {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .net__nodes li:nth-child(-n + 3)::before {
    content: '';
    position: absolute;
    top: -18px;
    left: 50%;
    height: 18px;
    border-left: 2px solid var(--ink);
  }
  .net__nodes li:nth-child(n + 4)::before {
    content: '';
    position: absolute;
    top: -18px;
    left: 50%;
    height: 18px;
    border-left: 2px dotted var(--ink-soft);
  }
  .node-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    color: var(--ink);
    text-decoration: none;
    padding: 2px;
  }
  .node {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    color: var(--accent);
  }
  .node :global(svg) {
    width: 24px;
    height: 24px;
  }
  .node--me {
    width: 60px;
    height: 60px;
    background: var(--accent);
    color: var(--paper);
  }
  .node--me :global(svg) {
    width: 30px;
    height: 30px;
  }
  .net__label {
    font-size: 15px;
    padding: 0 4px;
  }
  .node-link:hover .net__label,
  .node-link:focus-visible .net__label {
    background: var(--accent);
    color: var(--paper);
  }
  .node-link:active .node {
    box-shadow: var(--shadow-inner-3);
  }
  .net__wip {
    margin-top: 22px;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px;
    box-shadow: var(--shadow-inner-1);
    color: var(--ink-soft);
  }
  .node--wip {
    color: var(--win-shadow);
    flex: none;
  }
  .net__wip p {
    display: grid;
    font-size: 15px;
    line-height: 1.3;
  }
  .net__wip b {
    font-weight: 400;
    color: var(--ink);
  }

  /* ---------- compose window ---------- */
  .mail fieldset {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .mail__row {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    align-items: center;
    gap: 8px;
  }
  .mail input {
    width: 100%;
    height: 34px;
    padding: 4px 8px;
    font-family: var(--font-type);
    font-size: 14px;
  }
  .mail input[readonly] {
    background: var(--win-light);
  }
  textarea {
    width: 100%;
    flex: 1;
    min-height: 160px;
    resize: vertical;
    border: none;
    padding: 10px 12px;
    background: var(--paper-warm);
    box-shadow: var(--shadow-inner-4);
    font-family: var(--font-type);
    font-size: 14px;
    line-height: 1.6;
  }
  textarea:focus {
    outline: none;
    background: var(--paper);
  }
  .mail__actions {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 8px;
  }
  .mail__actions .btn,
  .mail__actions button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    font: inherit;
  }

  @media (max-width: 720px) {
    .connect__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
